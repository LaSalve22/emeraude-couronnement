RivalsHouse_2F_EventScript_Rival::
	lockall
	goto_if_set FLAG_MET_RIVAL_LILYCOVE, RivalsHouse_2F_EventScript_RivalPostLilycove
	checkplayergender
	goto_if_eq VAR_RESULT, MALE, RivalsHouse_2F_EventScript_May
	goto_if_eq VAR_RESULT, FEMALE, RivalsHouse_2F_EventScript_Brendan
	end

RivalsHouse_2F_EventScript_May::
	msgbox RivalsHouse_2F_Text_MayGettingReady, MSGBOX_DEFAULT
	releaseall
	end

RivalsHouse_2F_EventScript_Brendan::
	msgbox RivalsHouse_2F_Text_BrendanGettingReady, MSGBOX_DEFAULT
	releaseall
	end

RivalsHouse_2F_EventScript_RivalPostLilycove::
	applymovement VAR_LAST_TALKED, Common_Movement_FacePlayer
	waitmovement 0
	checkplayergender
	call_if_eq VAR_RESULT, MALE, RivalsHouse_2F_EventScript_MayPostLilycove
	call_if_eq VAR_RESULT, FEMALE, RivalsHouse_2F_EventScript_BrendanPostLilycove
	setflag FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE
	releaseall
	end

RivalsHouse_2F_EventScript_MayPostLilycove::
	goto_if_set FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE, RivalsHouse_2F_EventScript_MayWhereShouldIGoNext
	msgbox RivalsHouse_2F_Text_MayJustCheckingMyPokedex, MSGBOX_DEFAULT
	return

RivalsHouse_2F_EventScript_BrendanPostLilycove::
	goto_if_set FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE, RivalsHouse_2F_EventScript_BrendanWhereShouldIGoNext
	msgbox RivalsHouse_2F_Text_BrendanJustCheckingMyPokedex, MSGBOX_DEFAULT
	return

RivalsHouse_2F_EventScript_MayWhereShouldIGoNext::
	msgbox RivalsHouse_2F_Text_MayWhereShouldIGoNext, MSGBOX_DEFAULT
	return

RivalsHouse_2F_EventScript_BrendanWhereShouldIGoNext::
	msgbox RivalsHouse_2F_Text_BrendanWhereShouldIGoNext, MSGBOX_DEFAULT
	return

LittlerootTown_MaysHouse_2F_EventScript_PC::
	lockall
	checkplayergender
	goto_if_eq VAR_RESULT, MALE, LittlerootTown_MaysHouse_2F_EventScript_CheckRivalsPC
	goto_if_eq VAR_RESULT, FEMALE, LittlerootTown_MaysHouse_2F_EventScript_CheckPlayersPC
	end

LittlerootTown_MaysHouse_2F_EventScript_CheckRivalsPC::
	msgbox gText_PokemonTrainerSchoolEmail, MSGBOX_DEFAULT
	releaseall
	end

LittlerootTown_MaysHouse_2F_EventScript_CheckPlayersPC::
	setvar VAR_0x8004, PC_LOCATION_MAYS_HOUSE
	special DoPCTurnOnEffect
	playse SE_PC_ON
	msgbox gText_PlayerHouseBootPC, MSGBOX_DEFAULT
	special BedroomPC
	releaseall
	end

LittlerootTown_MaysHouse_2F_EventScript_TurnOffPlayerPC::
	setvar VAR_0x8004, PC_LOCATION_MAYS_HOUSE
	playse SE_PC_OFF
	special DoPCTurnOffEffect
	releaseall
	end

RivalsHouse_2F_Text_MayWhoAreYou:
	.string "Hein ? Qui… Qui es-tu ?\p"
	.string "… … … … … … … … … … … …\p"
	.string "Ah, tu es {PLAYER}. C'est aujourd'hui que\n"
	.string "vous emménagiez.\p"
	.string "Euh… Moi, c'est Flora. Enchantée !\p"
	.string "J'ai… J'ai un rêve : devenir amie avec les\n"
	.string "Pokémon du monde entier. Tous. Même les\l"
	.string "moches.\p"
	.string "Mon père, le Prof. Seko, m'a parlé de toi.\p"
	.string "J'espérais que tu serais gentil, et\n"
	.string "qu'on pourrait devenir amis.\p"
	.string "Oh, c'est bête, hein ? On vient à peine\n"
	.string "de se rencontrer.\p"
	.string "Héhéhé… Oublie ce que j'ai dit. Ou pas.\p"
	.string "Oh non ! J'avais oublié !\p"
	.string "Je devais aider Papa à capturer des\n"
	.string "Pokémon sauvages ! Il va encore se\l"
	.string "faire courser par un Medhyèna.\p"
	.string "{PLAYER}, à plus tard !$"

RivalsHouse_2F_Text_MayGettingReady:
	.string "Pokémon soignés ! Potions ! Pansements\n"
	.string "! Spray anti-morsure ! Et…$"

RivalsHouse_2F_Text_BrendanWhoAreYou:
	.string "Hé ! Toi…\p"
	.string "T'es qui ?\p"
	.string "Ah, t'es {PLAYER}, c'est ça ? La nouvelle\n"
	.string "voisine ?\p"
	.string "Je savais pas que t'étais une fille.\p"
	.string "Mon père, le Prof. Seko, m'a dit que\n"
	.string "l'enfant d'un Champion d'Arène\l"
	.string "emménageait à côté. J'ai cru que ce\n"
	.string "serait un mec. Mon erreur.\p"
	.string "Moi, c'est Brice. Salut, voisine !\p"
	.string "Hein ? Attends, t'as pas de Pokémon ?\p"
	.string "Tu veux que j'aille t'en attraper un ? Un\n"
	.string "petit, pas trop méchant ?\p"
	.string "Ah, zut, j'avais oublié…\p"
	.string "Je dois aider mon père à capturer des\n"
	.string "Pokémon sauvages. Il est nul pour ça. Le\l"
	.string "génie de la famille, c'est pas lui.\p"
	.string "Une autre fois, OK ?$"

RivalsHouse_2F_Text_BrendanGettingReady:
	.string "Pokémon soignés… Sac bouclé… Charisme\n"
	.string ": au max… Et…$"

RivalsHouse_2F_Text_ItsRivalsPokeBall:
	.string "C'est la Poké Ball de {RIVAL} !\p"
	.string "Mieux vaut ne pas y toucher. Il y a un\n"
	.string "post-it : “TOUCHE PAS.”$"

RivalsHouse_2F_Text_MayJustCheckingMyPokedex:
	.string "Flora : {PLAYER} !\p"
	.string "Je regardais mon Pokédex.\p"
	.string "Y a plein de Pokémon que j'ai vus sans\n"
	.string "réussir à les attraper. L'un d'eux m'a\l"
	.string "même volé mon goûter.\p"
	.string "Et d'autres qui vont évoluer. Si je les\n"
	.string "garde en vie assez longtemps.\p"
	.string "Tu sais, mon père dit qu'un Pokédex,\n"
	.string "c'est la liste de tout ce qu'on a eu la\l"
	.string "chance de croiser. Moi, j'y vois surtout\n"
	.string "ce qui manque.$"

RivalsHouse_2F_Text_MayWhereShouldIGoNext:
	.string "Flora : Je me demande où aller chasser,\n"
	.string "maintenant…\p"
	.string "Ce serait drôle qu'on se croise,\n"
	.string "{PLAYER}. Drôle pour moi. Toi, tu vas\l"
	.string "pleurer.$"

RivalsHouse_2F_Text_BrendanJustCheckingMyPokedex:
	.string "Brice : Tiens, {PLAYER}.\p"
	.string "Je regardais mon Pokédex.\p"
	.string "Il m'en manque encore un paquet, mais ça\n"
	.string "commence à avoir de la gueule.\p"
	.string "Mon père a rempli le sien à mon âge. Je le\n"
	.string "sais, il me l'a dit. Quarante fois.$"

RivalsHouse_2F_Text_BrendanWhereShouldIGoNext:
	.string "Brice : J'hésite sur ma prochaine zone\n"
	.string "de chasse.\p"
	.string "Hé, {PLAYER}. Si je te croise en route, je\n"
	.string "te défonce. Rien de personnel. Enfin, un\l"
	.string "peu.$"
